#!/bin/bash
# N_MI noise sweep and scored study on one Gadi node (no pyspi).
#   qsub -v OUT=<dir>,OFFSET=3 research/estimators/jobs/nmi.pbs   (from the checkout root)
# Writes <OUT>/noise and <OUT>/study (rows, truth, summary); analyse locally on a copy, so the checkout stays clean:
#   python -m research.estimators.nmi_noise --out <copy>/noise --figure-only
#   python -m research.estimators.nmi analyse --out <copy>/study
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=96GB,walltime=01:30:00
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
source jobs/gadi/env.sh
mkdir -p "$OUT"
git rev-parse HEAD > "$OUT/commit.txt"
python -u -m research.estimators.nmi_noise --out "$OUT/noise" --workers 47 --run-only
python -u -m research.estimators.nmi run --out "$OUT/study" --offset "${OFFSET:-3}" --workers 47
touch "$OUT/done"
