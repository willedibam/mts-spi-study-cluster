#!/bin/bash
#PBS -N strength-extract
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=8GB,walltime=00:30:00,jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
python -m research.proof.baselines.analyze_strength_factorial extract \
  --data "$MTS_SCRATCH/proof/strength-factorial-261015" \
  --out "$MTS_SCRATCH/proof/strength-factorial-261015/analysis" --workers 4
