#!/bin/bash
#PBS -N proof-release
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=00:15:00
#PBS -l jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
exec >"logs/${PBS_JOBNAME}_${PBS_JOBID%%.*}.log" 2>&1
python -m research.proof.p90.release_current_refresh "${PILOT_JOBS:?}"
