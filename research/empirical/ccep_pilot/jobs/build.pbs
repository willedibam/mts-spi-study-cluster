#!/bin/bash
#PBS -N ccep-build
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=8
#PBS -l mem=64GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${RUN_ROOT:?}" "${CODE_SNAPSHOT:?}" "${RATE:?}" "${CUTOFF:?}" "${WINDOW_SECONDS:?}"
cd "$CODE_SNAPSHOT"
source jobs/gadi/env.sh
exec >"$RUN_ROOT/logs/build-${PBS_JOBID%%.*}.log" 2>&1
python -u -m research.empirical.ccep_pilot.prepare long-windows --root "$RUN_ROOT" --rate "$RATE" --cutoff "$CUTOFF"
python -u -m research.empirical.ccep_pilot.prepare build --root "$RUN_ROOT" --rate "$RATE" --cutoff "$CUTOFF" --seconds "$WINDOW_SECONDS" --reference-control
