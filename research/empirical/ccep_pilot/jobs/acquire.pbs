#!/bin/bash
#PBS -N ccep-fetch
#PBS -P ql44
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${RUN_ROOT:?}" "${CODE_SNAPSHOT:?}"
cd "$CODE_SNAPSHOT"
source jobs/gadi/env.sh
mkdir -p "$RUN_ROOT/logs"
exec >"$RUN_ROOT/logs/acquire-${PBS_JOBID%%.*}.log" 2>&1
python -u -m research.empirical.ccep_pilot.acquire \
    --selection research/empirical/ccep_pilot/configs/selection.json --root "$RUN_ROOT"
