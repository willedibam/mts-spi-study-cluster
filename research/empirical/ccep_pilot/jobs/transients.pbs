#!/bin/bash
#PBS -N ccep-contact-qc
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=2
#PBS -l mem=16GB
#PBS -l walltime=00:20:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${RUN_ROOT:?}"
cd "$PBS_O_WORKDIR"
source jobs/gadi/env.sh
exec >"$RUN_ROOT/logs/transients-${PBS_JOBID%%.*}.log" 2>&1
python -u -m research.empirical.ccep_pilot.prepare transients --root "$RUN_ROOT"
