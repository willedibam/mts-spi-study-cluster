#!/bin/bash
#PBS -N hardware-fetch
#PBS -P ql44
#PBS -q copyq
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=04:00:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${RUN_ROOT:?}" "${CODE_SNAPSHOT:?}"
module load python3/3.12.1
source /scratch/ql44/we2614/mts-spi-study/environments/mts-spi-v3-631de27/bin/activate
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
mkdir -p "$RUN_ROOT/logs"
exec >"$RUN_ROOT/logs/fetch-${RECORD_ID:-17451096}-${PBS_JOBID%%.*}.log" 2>&1
python -u "$CODE_SNAPSHOT/research/empirical/hardware_pilot/download_hardware_pilot.py" \
    --record "${RECORD_ID:-17451096}" --root "$RUN_ROOT/raw/${RECORD_ID:-17451096}" \
    --steps ${STEPS:-0 87 175 262 350 437 525 612 700}
