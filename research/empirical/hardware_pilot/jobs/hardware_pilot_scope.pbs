#!/bin/bash
#PBS -N hardware-scope
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${RUN_ROOT:?}" "${CODE_SNAPSHOT:?}"
module load python3/3.12.1
source /scratch/ql44/we2614/mts-spi-study/environments/mts-spi-v3-631de27/bin/activate
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
cd "$CODE_SNAPSHOT"
python -u -m research.empirical.hardware_pilot.hardware_pilot scope --raw "$RUN_ROOT/raw/${RECORD_ID:-17451096}" --output "$RUN_ROOT/scope-er"
python -c 'import sys; from pathlib import Path; from research.empirical.hardware_pilot.plot_hardware_pilot import sampling_figures; sampling_figures(Path(sys.argv[1]))' "$RUN_ROOT/scope-er"
