#!/bin/bash
#PBS -N discovery-raw
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=16GB,walltime=12:00:00,jobfs=4GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
if [[ "${METHOD:?}" == minirocket ]]; then
    module purge
    module load python3/3.12.1
    deactivate
    python3 -m venv "$PBS_JOBFS/aeon"
    "$PBS_JOBFS/aeon/bin/python" -m pip install --no-index --find-links "${WHEELHOUSE:?}" aeon==1.5.0 pyyaml
    "$PBS_JOBFS/aeon/bin/python" -u -m research.representation.dataset_screen.raw --root "${RUN_ROOT:?}" --method minirocket
else
    python -u -m research.representation.dataset_screen.raw --root "${RUN_ROOT:?}" --method "$METHOD"
fi
