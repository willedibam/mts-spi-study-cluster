#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=190GB,walltime=04:00:00,jobfs=1GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -N c1_families
#PBS -j oe
# Run from the source snapshot: qsub -J 0-<n-1> -v SRC=<snapshot>,N=<n> jobs/families.pbs (timing: -v SRC=..,N=1260,ONE=1, no -J)
set -euo pipefail
cd "$SRC"; source jobs/gadi/env.sh
export PYSPI_SOURCE=$MTS_SCRATCH/operations/sources/pyspi-upstream-0c798b4 PYTHONPATH=$MTS_SCRATCH/operations/sources/pyspi-upstream-0c798b4:$PYTHONPATH
A=$MTS_SCRATCH/atlas; O=$MTS_GDATA/representation/atlas-movers-261117/families; mkdir -p $O
i=${PBS_ARRAY_INDEX:-0}; W=${PBS_NCPUS}
[[ -n "${ONE:-}" ]] && W=1
python -c 'import pyspi; print(pyspi.__file__)'
python research/representation/atlas/movers/families_iaaft.py compute $A/banks/neurotycho-short $A/pyspi/neurotycho-short \
  research/representation/atlas/movers/families.yaml $O/fam_${i}of${N}.npz $i $N $W
