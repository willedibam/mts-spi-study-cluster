#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -N axis_gaussref
#PBS -j oe
# Gaussian-referenced readouts (../result.md, ../gaussref.py). From the synced checkout's root:
#   qsub -l ncpus=48,mem=190GB,walltime=01:00:00 research/representation/atlas/axis_screen/jobs/gaussref.pbs
# Both banks, preps z, z-m, ns; outputs gaussref-{long,short}-$PREP.{npz,json}.
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
A=$MTS_SCRATCH/atlas
for ARM in long short; do
    B=$A/banks/neurotycho-$ARM
    for PREP in z z-m ns; do
        N=gaussref-$ARM-$PREP; O=$A/axis_screen/$N; mkdir -p "$O"
        git rev-parse HEAD > "$O/commit.txt"
        python -u -m research.representation.atlas.axis_screen.gaussref compute "$B" "$O" "$PBS_NCPUS" "$PREP"
        python -u -m research.representation.atlas.axis_screen.gaussref collect "$O" "$A/axis_screen/$N.npz"
        python -u -m research.representation.atlas.axis_screen.mechanism score "$A/axis_screen/$N.npz" "$B/manifest.json" "$A/axis_screen/$N.json"
    done
done
