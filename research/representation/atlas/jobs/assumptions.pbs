#!/bin/bash
#PBS -N atlas-assumptions
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=24,mem=96GB,walltime=00:45:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# Assumption classes over the whole z atlas (assumptions.py): edge-profile reliability of every valid SPI, then
# class scores and the annotated reverse ranking, NeuroTycho arms. qsub research/representation/atlas/jobs/assumptions.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
A="$MTS_SCRATCH/atlas"
for bank in neurotycho-short neurotycho-long-stage-a; do
    [ -s "$A/discovery/$bank-reliability-all.json" ] || python -u -m research.representation.atlas.assumptions reliability "$A/banks/$bank" "$A/pyspi/$bank" "$A/discovery/$bank-reduced.npz" --jobs 24 --output "$A/discovery/$bank-reliability-all.json"
    python -u -m research.representation.atlas.assumptions score "$A/discovery/$bank-reduced.npz" --reliability "$A/discovery/$bank-reliability-all.json" --output "$A/discovery/$bank-assumptions.json"
done
