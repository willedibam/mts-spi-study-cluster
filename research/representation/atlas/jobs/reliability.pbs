#!/bin/bash
#PBS -N atlas-reliability
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=16,mem=64GB,walltime=01:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# Edge-profile reliability and disattenuated z of the named SPI pairs, per arm (discovery.py reliability).
# qsub research/representation/atlas/jobs/reliability.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
A="$MTS_SCRATCH/atlas"
for arm in neurotycho-short:awake_ec neurotycho-long-stage-a:awake_ec fly-short:awake; do
    IFS=: read -r bank ref <<< "$arm"
    python -u -m research.representation.atlas.discovery reliability "$A/banks/$bank" "$A/pyspi/$bank" --reference "$ref" --jobs 16 --output "$A/discovery/$bank-reliability.json"
done
