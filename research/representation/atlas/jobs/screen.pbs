#!/bin/bash
#PBS -N atlas-screen
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=8,mem=64GB,walltime=01:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# SPI-pair screen over every kept z coordinate (discovery.py screen), raw z and double-centred z, per arm.
# qsub research/representation/atlas/jobs/screen.pbs   (after discovery.pbs)
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
O="$MTS_SCRATCH/atlas/discovery"
for arm in neurotycho-long-stage-a neurotycho-short; do
    python -u -m research.representation.atlas.discovery screen "$O/$arm-reduced.npz" --output "$O/$arm-screen.json"
    python -u -m research.representation.atlas.discovery screen "$O/$arm-reduced.npz" --double-centred --output "$O/$arm-screen-dc.json"
done
python -u -m research.representation.atlas.discovery screen "$O/fly-short-reduced.npz" --reference awake --drug-state isoflurane --output "$O/fly-short-screen.json"
