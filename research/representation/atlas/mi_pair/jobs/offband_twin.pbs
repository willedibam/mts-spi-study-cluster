#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=48GB,jobfs=4GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -j oe
# Linear-Gaussian twin of every zns window (offband_twin.py; rules in preregs/offband-twin-prereg.md). Runs from a
# commit-named source snapshot S (git archive of src/ and this folder), never the shared checkout. Submit:
#   qsub -N tw_smoke -l walltime=00:20:00 -v S=$S,MODE=smoke offband_twin.pbs
#   qsub -r y -N tw_run -J 0-9 -l walltime=01:00:00 -W depend=afterok:<smoke> -v S=$S,MODE=run offband_twin.pbs
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
cd $S/research/representation/atlas/mi_pair || exit 2
B=/scratch/ql44/we2614/mts-spi-study/atlas/banks; G=/g/data/ql44/we2614/mts-spi-study/representation/atlas-mi-pair-261117
O=$G/offband/twin; mkdir -p $O; PY="env PYTHONPATH=$S/src /home/562/we2614/mts-spi-study-cluster/.venv/bin/python"
basename $S > $O/source.txt
case $MODE in
  smoke) $PY offband_twin.py run $B $G/zns $O/smoke.npz 0 10 48 24 | tee $O/smoke.txt; exit ${PIPESTATUS[0]} ;;
  run)   $PY offband_twin.py run $B $G/zns $O/tw_$PBS_ARRAY_INDEX.npz $PBS_ARRAY_INDEX 10 48 | tee $O/run_$PBS_ARRAY_INDEX.txt; exit ${PIPESTATUS[0]} ;;
esac
