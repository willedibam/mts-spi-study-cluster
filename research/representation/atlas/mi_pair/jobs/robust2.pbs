#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=96GB,walltime=04:00:00,jobfs=4GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -N rb2
#PBS -j oe
# 2-s arms (own bank and 10-s windows cut in five) with kshift, and the synthetic calibration (preregs/robust-prereg.md).
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
cd $SRC/research/representation/atlas/mi_pair || exit 2
B=/scratch/ql44/we2614/mts-spi-study/atlas/banks; O=/g/data/ql44/we2614/mts-spi-study/representation/atlas-mi-pair-261117/robust; mkdir -p $O
PY="env PYTHONPATH=$SRC/src /home/562/we2614/mts-spi-study-cluster/.venv/bin/python"; echo "commit $(basename $SRC)" > $O/commit2.txt
$PY robust.py calib $B/neurotycho-long-stage-a $O/rcalib.npz 40 48 || exit 3
$PY robust.py cscore $O/rcalib.npz > $O/calib.txt || exit 3
for a in PF KT KTMD MD; do $PY robust.py run $B/neurotycho-short $O/rbS2_S_$a.npz $a first 48 --shift || exit 4; done
$PY robust.py run $B/neurotycho-short $O/rbS2_S_SLP.npz SLP row 48 --shift || exit 4
$PY robust.py score $O rbS2 > $O/scoreS2.txt || exit 4
for a in PF KT KTMD MD SLP; do $PY robust.py run $B/neurotycho-long-stage-a $O/rbC2_A_$a.npz $a first 48 --shift --cut 5 || exit 5; done
for a in PF KT KTMD MD; do $PY robust.py run $B/neurotycho-long-stage-b $O/rbC2_B_$a.npz $a first 48 --shift --cut 5 || exit 5; done
$PY robust.py run $B/neurotycho-long-stage-b $O/rbC2_B_SLP.npz SLP row 48 --shift --cut 5 || exit 5
$PY robust.py score $O rbC2 > $O/scoreC2.txt && cd $O && sha256sum rcalib.npz rbS2_*.npz rbC2_*.npz > SHA256SUMS.rb2 && echo ALLDONE
