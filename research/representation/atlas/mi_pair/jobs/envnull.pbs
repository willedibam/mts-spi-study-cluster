#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=96GB,walltime=03:00:00,jobfs=4GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -N mi_envnull
#PBS -j oe
# Gain-over-floor null of the MI pair (../preregs/envelope-prereg.md). VARIANT = the confirmed calibration variant.
VARIANT=${VARIANT:?pass -v VARIANT=<sigma-floor>}
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
R=/home/562/we2614/mts-spi-study-cluster; cd $R/research/representation/atlas/mi_pair/envnull || exit 2
B=/scratch/ql44/we2614/mts-spi-study/atlas/banks; O=/g/data/ql44/we2614/mts-spi-study/representation/atlas-mi-pair-261117; mkdir -p $O/envnull
PY="env PYTHONPATH=$R/src $R/.venv/bin/python"; git -C $R log -1 --format='commit %H' > $O/envnull/commit.txt
for a in PF KT KTMD MD SLP; do $PY run.py $B/neurotycho-long-stage-a $O/envnull/env_A_$a.npz $a first 48 $VARIANT || exit 3; done
for a in PF KT KTMD MD; do $PY run.py $B/neurotycho-long-stage-b $O/envnull/env_B_$a.npz $a first 48 $VARIANT || exit 3; done
$PY run.py $B/neurotycho-long-stage-b $O/envnull/env_B_SLP.npz SLP row 48 $VARIANT || exit 3
$PY run.py score $O/envnull > $O/envnull/score.txt && cd $O/envnull && sha256sum env_*.npz > SHA256SUMS && echo ALLDONE
