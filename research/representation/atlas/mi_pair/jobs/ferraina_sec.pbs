#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=64GB,walltime=04:00:00,jobfs=2GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -N fbsec
#PBS -j oe
# Monkey B secondaries (preregs/ferraina-prereg.md, Clarifications 8-9). qsub -v SRC=<snapshot>,VARS=<v1,v2,...>[,TAG=<name>]
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 NJOBS=48
cd $SRC/research/representation/atlas/mi_pair/ferraina || exit 2
S=/scratch/ql44/we2614/mts-spi-study/atlas/ferraina/sel; O=/g/data/ql44/we2614/mts-spi-study/representation/atlas-mi-pair-261117/ferraina; mkdir -p $O
PY="env PYTHONPATH=$SRC/src /home/562/we2614/mts-spi-study-cluster/.venv/bin/python"; echo "commit $(basename $SRC) vars $VARS" > $O/commit_${TAG:-sec}.txt
$PY fb_z.py $S $O/fb_z_${TAG:-sec}.npz $VARS || exit 3
cd $O && sha256sum fb_z_${TAG:-sec}.npz > SHA256SUMS.${TAG:-sec} && echo ALLDONE
