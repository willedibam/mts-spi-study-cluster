#!/bin/bash
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=96GB,walltime=02:00:00,jobfs=4GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -N mi_transient
#PBS -j oe
# Transient cut of the MI pair (../preregs/transient-prereg.md). SRC: a source snapshot (operations/sources/...) of the
# commit that adds it; the environment is the main checkout's .venv.
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
R=/home/562/we2614/mts-spi-study-cluster; cd $SRC/research/representation/atlas/mi_pair/transient || exit 2
B=/scratch/ql44/we2614/mts-spi-study/atlas/banks; O=/g/data/ql44/we2614/mts-spi-study/representation/atlas-mi-pair-261117; mkdir -p $O/transient
PY="env PYTHONPATH=$SRC/src $R/.venv/bin/python"; basename $SRC > $O/transient/source.txt
for a in PF KT KTMD MD SLP; do $PY run.py $B/neurotycho-long-stage-a $O/transient/tr_A_$a.npz $a first 48 || exit 3; done
for a in PF KT KTMD MD; do $PY run.py $B/neurotycho-long-stage-b $O/transient/tr_B_$a.npz $a first 48 || exit 3; done
$PY run.py $B/neurotycho-long-stage-b $O/transient/tr_B_SLP.npz SLP row 48 || exit 3
$PY run.py score $O/transient > $O/transient/score.txt && cd $O/transient && sha256sum tr_*.npz > SHA256SUMS && echo ALLDONE
