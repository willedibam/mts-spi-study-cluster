#!/bin/bash
#PBS -N axes-validation
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=480,mem=1800GB,walltime=01:30:00,jobfs=10GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# Construction-validation farm: every window of the main and post hoc designs, a few windows per
# nci-parallel task. Resumable: finished windows are skipped, so a second pass retries failures.
# qsub -v VALIDATION_OUT=<dir>/raw research/representation/character_axes/validation/jobs/farm.pbs
# Stage 2 (second-family mediation and direction, 520 windows): add STAGE=2 to -v and book one node,
# qsub -l ncpus=48,mem=190GB,walltime=00:45:00 -v STAGE=2,VALIDATION_OUT=<dir2>/raw .../farm.pbs
# Stage 3 (spectral location and joint bursts, 2,972 windows, spis_stage3.yaml): STAGE=3 on four nodes,
# qsub -l ncpus=192,mem=760GB,walltime=01:30:00 -v STAGE=3,VALIDATION_OUT=<dir3>/raw .../farm.pbs
# Dispersion-sign correction (1,596 windows into <dirc>/raw1 and <dirc>/raw3):
# qsub -l ncpus=144,mem=570GB,walltime=01:30:00 -v STAGE=corr,VALIDATION_OUT=<dirc>/raw1 .../farm.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
export VALIDATION_OUT="${VALIDATION_OUT:?}"
mkdir -p "$VALIDATION_OUT"
log="$(dirname "$VALIDATION_OUT")"
mod=research.representation.character_axes.validation.run
per_task="${WINDOWS_PER_TASK:-4}"
case "${STAGE:-1}" in
    2) flags=(--stage2) ;;
    3) flags=(--stage3) ;;
    corr) flags=("--correction 1 --out $log/raw1" "--correction 3 --out $log/raw3") ;;
    *) flags=('' --posthoc) ;;
esac

mpirun -np $(( (PBS_NCPUS + 47) / 48 )) --map-by ppr:1:node python -c 'import mtsspi, pyspi; print(mtsspi.__file__, pyspi.__file__)'
# Smoke: one window in this process before the farm; stop unless it succeeded.
smoke=$(python -u -m "$mod" ${flags[0]} --shard 0 --shards 1 --limit 1); echo "$smoke"; grep -q '^ok ' <<<"$smoke"

commands="$PBS_JOBFS/commands.txt"
: > "$commands"
for flag in "${flags[@]}"; do
    n=$(python -m "$mod" $flag --dry | awk 'NR==1{print $1}')
    shards=$(( (n + per_task - 1) / per_task ))
    for (( k = 0; k < shards; k++ )); do echo "python -u -m $mod $flag --shard $k --shards $shards" >> "$commands"; done
done
echo "[INFO] $(wc -l < "$commands") tasks on $PBS_NCPUS cores"

for pass in 1 2; do
    set +e
    mpirun -np "$PBS_NCPUS" --map-by node:PE=1 nci-parallel --verbose --input-file "$commands" \
        --status "$log/farm-${PBS_JOBID%%.*}-pass$pass.status" > "$log/farm-${PBS_JOBID%%.*}-pass$pass.log" 2>&1
    echo "[INFO] pass $pass exit $?"
    set -e
done
for flag in "${flags[@]}"; do python -m "$mod" $flag --dry; done
