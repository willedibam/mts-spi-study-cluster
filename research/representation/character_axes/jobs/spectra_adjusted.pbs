#!/bin/bash
#PBS -N axes-spec-adj
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=32GB,walltime=01:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# NeuroTycho core readouts and top z pairs, before and after adjusting for channel spectra.
# qsub research/representation/character_axes/jobs/spectra_adjusted.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
R=/g/data/ql44/we2614/mts-spi-study/representation/empirical/character-axes-261102
python -u -m research.representation.character_axes.spectra_adjusted \
    --root "$MTS_SCRATCH/representation/empirical/character-transfer-261031/neurotycho-primary" \
    --figure-data "$R/figure-data/neurotycho.npz" --output "$R/spectra-adjusted/neurotycho.json"
