#!/bin/bash
#PBS -N axes-surr-pairs
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=48GB,walltime=01:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# NeuroTycho top z pairs and core readouts: real versus multivariate IAAFT (three variants).
# qsub research/representation/character_axes/jobs/surrogate_pairs.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
E=$MTS_SCRATCH/representation/empirical
R=/g/data/ql44/we2614/mts-spi-study/representation/empirical/character-axes-261102
python -u -m research.representation.character_axes.surrogate_pairs --real "$E/character-transfer-261031/neurotycho-primary" \
    --surrogates "$E"/character-axes-261102/surr-neurotycho{,-marginal1000,-spectrum} \
    --figure-data "$R/figure-data/neurotycho.npz" --output "$R/surrogate-pairs/neurotycho.json"
