#!/bin/bash
#PBS -N axes-decouple-gen
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=16,mem=32GB,walltime=02:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# Generator calibration: which mechanism decouples direct from pairwise dependence patterns.
# qsub research/representation/character_axes/jobs/decoupling_generator.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
R=/g/data/ql44/we2614/mts-spi-study/representation/empirical/character-axes-261102
python -u -m research.representation.character_axes.decoupling_generator --output "$R/decoupling-generator/sweep.json" --seeds "${SEEDS:-20}" --jobs 16
