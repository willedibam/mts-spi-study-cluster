#!/bin/bash
#PBS -N axes-episodic
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=16,mem=64GB,walltime=02:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# Episodic-dependence deciding analyses (episodic.py): NeuroTycho discovery bank and propofol, real and both IAAFT variants.
# qsub research/representation/character_axes/jobs/episodic.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
E="$MTS_SCRATCH/representation/empirical"
C="$E/character-axes-261102"
O=/g/data/ql44/we2614/mts-spi-study/representation/empirical/character-axes-261102/episodic
python -u -m research.representation.character_axes.episodic neurotycho --real "$E/character-transfer-261031/neurotycho-primary/bank.npz" \
    --surrogates "$C/surr-neurotycho/bank.npz" "$C/surr-neurotycho-spectrum/bank.npz" --output "$O/neurotycho.json" --jobs 16
python -u -m research.representation.character_axes.episodic propofol --real "$C/propofol/bank.npz" \
    --surrogates "$C/surr-propofol-marginal/bank.npz" "$C/surr-propofol-spectrum/bank.npz" --output "$O/propofol.json" --jobs 16
