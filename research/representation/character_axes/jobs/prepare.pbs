#!/bin/bash
#PBS -N axes-prep
#PBS -P ql44
#PBS -q copyq
#PBS -l ncpus=1,mem=8GB,walltime=10:00:00,jobfs=20GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
if [[ "${CORPUS:?}" == propofol ]]; then
    # The propofol archive stores MATLAB v7.3 (HDF5) files; h5py stays out of the shared environment.
    /apps/python3/3.12.1/bin/python3 -m pip install -q --target "$PBS_JOBFS/extra" h5py==3.16.0 --no-deps
    export PYTHONPATH="$PBS_JOBFS/extra:$PYTHONPATH"
fi
extra=()
[[ -n "${BANK:-}" ]] && extra+=(--bank "$BANK" --name "${NAME:?}")
[[ "${INSPECT:-0}" == 1 ]] && extra+=(--inspect)
python -u -m research.representation.character_axes.prepare "${CORPUS:?}" --root "${RUN_ROOT:?}" "${extra[@]}"
if [[ "${INSPECT:-0}" != 1 && -n "${CHAIN:-}" ]]; then
    python -u -m research.representation.character_axes.launch --root "$RUN_ROOT" --stage pilot
fi
