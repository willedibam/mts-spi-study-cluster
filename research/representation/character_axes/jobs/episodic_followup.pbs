#!/bin/bash
#PBS -N axes-episodic-2
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=32,mem=96GB,walltime=03:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# Episodic follow-up (episodic.py): what the flagged samples are (discovery NeuroTycho, propofol), and the
# flag index on the atlas NeuroTycho 10-s bank and the fly bank with per-window IAAFT surrogates.
# qsub research/representation/character_axes/jobs/episodic_followup.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
E="$MTS_SCRATCH/representation/empirical"
C="$E/character-axes-261102"
B="$MTS_SCRATCH/atlas/banks"
O=/g/data/ql44/we2614/mts-spi-study/representation/empirical/character-axes-261102/episodic
python -u -m research.representation.character_axes.episodic neurotycho --real "$E/character-transfer-261031/neurotycho-primary/bank.npz" \
    --surrogates "$C/surr-neurotycho/bank.npz" "$C/surr-neurotycho-spectrum/bank.npz" --analyses character --fs 250 \
    --output "$O/neurotycho-character.json" --jobs 32
python -u -m research.representation.character_axes.episodic propofol --real "$C/propofol/bank.npz" \
    --surrogates "$C/surr-propofol-marginal/bank.npz" "$C/surr-propofol-spectrum/bank.npz" --analyses character --fs 100 \
    --output "$O/propofol-character.json" --jobs 32
python -u -m research.representation.character_axes.episodic atlas --real "$B/fly-short" --reference awake \
    --output "$O/atlas-fly.json" --jobs 32
python -u -m research.representation.character_axes.episodic atlas --real "$B/neurotycho-long" --reference awake_ec \
    --output "$O/atlas-neurotycho-long.json" --jobs 32
