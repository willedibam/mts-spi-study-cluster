#!/bin/bash
#PBS -N fill-inception
#PBS -P ql44
#PBS -q gpuvolta
#PBS -l ncpus=12,ngpus=1,mem=64GB,walltime=12:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
# InceptionTime on one cohort contrast; resumes from its progress files.
# qsub -v COHORT=lemon,ROOT_DIR=<run>,OUT=<dir>[,ONLY=<contrast>] .../inception.pbs
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
python -u -m research.representation.comparator_fill.cohort_inception "${COHORT:?}" --root "${ROOT_DIR:?}" --output "${OUT:?}" ${ONLY:+--only "$ONLY"}
