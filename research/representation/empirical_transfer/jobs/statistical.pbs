#!/bin/bash
#PBS -N empirical-stat
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=2,mem=12GB,walltime=02:00:00,jobfs=1GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
animal_args=()
[[ -z "${TARGET_ANIMAL:-}" ]] || animal_args=(--animal "$TARGET_ANIMAL")
python -u -m research.representation.empirical_transfer.fit_source \
    --root "${RUN_ROOT:?}" --method "${METHOD:?}" "${animal_args[@]}"
