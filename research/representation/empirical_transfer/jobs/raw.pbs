#!/bin/bash
#PBS -N empirical-raw
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=16GB,walltime=08:00:00,jobfs=4GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
resume_args=()
[[ -z "${RESUME_FROM:-}" ]] || resume_args=(--resume-from "$RESUME_FROM")
if [[ "${METHOD:?}" == minirocket ]]; then
    # aeon needs a different NumPy. Its environment lives in jobfs so it
    # consumes no persistent project inodes and cannot modify the SPI runtime.
    module purge
    module load python3/3.12.1
    deactivate
    python3 -m venv "$PBS_JOBFS/aeon"
    "$PBS_JOBFS/aeon/bin/python" -m pip install --no-index --find-links "${WHEELHOUSE:?}" aeon==1.5.0 pyyaml
    "$PBS_JOBFS/aeon/bin/python" -u -m research.representation.empirical_transfer.fit_raw \
        --root "${RUN_ROOT:?}" --method minirocket --threads "$PBS_NCPUS"
else
    python -u -m research.representation.empirical_transfer.fit_raw \
        --root "${RUN_ROOT:?}" --method "$METHOD" --threads "$PBS_NCPUS" --device cpu "${resume_args[@]}"
fi
