#!/bin/bash
# One prepared corpus. LENGTH and COUNT are required; CHANNELS (canonical|common60), ANCHOR and SUBJECTS (colon-separated ids) are optional.
# qsub -v RAW_ROOT=...,ROOT=...,LENGTH=2000,COUNT=6 research/representation/chbmp_iq/jobs/prepare.pbs
#PBS -N chbmp-prepare
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1,mem=16GB,walltime=02:00:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
source jobs/gadi/env.sh
read -ra subjects <<< "${SUBJECTS//:/ }"
python -u -m research.representation.chbmp_iq.prepare --raw "${RAW_ROOT:?}" --root "${ROOT:?}" \
    --channels "${CHANNELS:-canonical}" --length "${LENGTH:?}" --count "${COUNT:?}" --minimum "${MINIMUM:-1}" \
    ${ANCHOR:+--anchor "$ANCHOR"} ${subjects:+--subjects "${subjects[@]}"}
