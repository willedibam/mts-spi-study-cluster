#!/bin/bash
#PBS -N spi_spi_feature_sel
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -V

cd "$PBS_O_WORKDIR"

# Activate env (adjust if needed)
if [ -f ".venv/Scripts/activate" ]; then
  source .venv/Scripts/activate
elif [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi

# Parameters (edit as needed)
MODE=${MODE:-full}
LIMIT=${LIMIT:-0}          # 0 means all datasets
TARGET_DIM=${TARGET_DIM:-12}
MAX_MRMR=${MAX_MRMR:-200}
SPLITS=${SPLITS:-5}

LIMIT_ARG=""
if [ "$LIMIT" -gt 0 ]; then
  LIMIT_ARG="--limit $LIMIT"
fi

python test_feature_selection.py \
  --mode "$MODE" \
  $LIMIT_ARG \
  --target-dim "$TARGET_DIM" \
  --max-mrmr "$MAX_MRMR" \
  --splits "$SPLITS" \
  --plots
