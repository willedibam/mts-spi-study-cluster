#!/bin/bash
#PBS -N bench_ref
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -q taiji
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Job 1 (reference): one full pass of (M=10, T=500) with 5 repeats over the
# fork's full config.yaml SPI superset. Not an array — single submit.
# Submitted to `taiji` (dedicated 32-core node, low contention) for a clean
# one-off headline timing. Change to `-q physics` if taiji is busy.

set -euo pipefail

if [[ -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "[ERROR] PBS_O_WORKDIR not set."
  exit 1
fi

cd "$PBS_O_WORKDIR"

LOG_DIR="$PBS_O_WORKDIR/logs"
mkdir -p "$LOG_DIR"
JOB_LABEL="${PBS_JOBNAME}_${PBS_JOBID%%.*}"
exec >"$LOG_DIR/${JOB_LABEL}.out" 2>"$LOG_DIR/${JOB_LABEL}.err"

module purge
source .venv/bin/activate

# physics/l40s/h100 queues export CUDA_VISIBLE_DEVICES="" on CPU-only jobs;
# cdt's autoset_settings() calls ast.literal_eval() on that empty string and
# dies at import (SyntaxError: invalid syntax (<unknown>, line 0)). Unset so
# cdt hits its KeyError/CPU fallback path. Harmless on taiji (already unset).
unset CUDA_VISIBLE_DEVICES

# One worker per task, so BLAS can use all ncpus — intentionally *not*
# sourcing scripts/activate.sh (which pins threads to 1 for multi-worker
# setups). Keep these in sync with ncpus above.
NCPUS=8
export OMP_NUM_THREADS=$NCPUS
export OPENBLAS_NUM_THREADS=$NCPUS
export MKL_NUM_THREADS=$NCPUS
export NUMEXPR_NUM_THREADS=$NCPUS
export VECLIB_MAXIMUM_THREADS=$NCPUS
export KMP_DUPLICATE_LIB_OK=TRUE

PYSPI_CONFIG=/suphys/wedi0306/pyspi-fork/pyspi/config.yaml
OUTPUT_DIR="$PBS_O_WORKDIR/data/benchmark/reference"
mkdir -p "$OUTPUT_DIR"

echo "[INFO] Reference run on $(hostname) at $(date)"
echo "[INFO] pyspi config: $PYSPI_CONFIG"
python scripts/benchmark_spis.py \
  --M 10 --T 500 \
  --repeats 5 \
  --pyspi-config "$PYSPI_CONFIG" \
  --output "$OUTPUT_DIR/reference_var1_M10_T500.json"
echo "[INFO] Finished at $(date)"
