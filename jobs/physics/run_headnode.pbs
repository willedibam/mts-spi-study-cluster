#!/bin/bash
#PBS -N myjob
#PBS -l select=1:ncpus=1:mem=4gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -m bea
#PBS -M your.email@uni.sydney.edu.au

set -euo pipefail
cd "$PBS_O_WORKDIR"

module purge
source .venv/bin/activate

# Pin BLAS threads to ncpus — BLAS otherwise detects the host's physical core
# count (~48) and oversubscribes the cgroup PBS assigned. Keep these in sync
# with ncpus on line 3 if you bump it.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

echo "[INFO] Started at $(date) on $(hostname)"
python your_script.py
echo "[INFO] Finished at $(date)"
