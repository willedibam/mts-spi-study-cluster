#!/bin/bash
#PBS -N r_rho_sweep
#PBS -l select=1:ncpus=4:mem=4gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -J 1-900
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Usage:
#   qsub -v SWEEP_CONFIG=configs/generate/r_rho_mi/sweep_260323/a_0.5.yaml jobs/physics/run_r_rho_mi_param_sweep.pbs
#
# Or run all sweep configs:
#   while IFS= read -r cfg; do
#     qsub -v SWEEP_CONFIG="$cfg" jobs/physics/run_r_rho_mi_param_sweep.pbs
#   done < configs/generate/r_rho_mi/sweep_260323/manifest.txt

set -euo pipefail

if [[ -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "[ERROR] PBS_O_WORKDIR not set."
  exit 1
fi

cd "$PBS_O_WORKDIR"

if [[ -z "${SWEEP_CONFIG:-}" ]]; then
  echo "[ERROR] SWEEP_CONFIG not set. Use: qsub -v SWEEP_CONFIG=path/to/config.yaml"
  exit 1
fi

if [[ ! -f "$SWEEP_CONFIG" ]]; then
  echo "[ERROR] Config not found: $SWEEP_CONFIG"
  exit 1
fi

# Derive a short label from config filename (e.g. a_0.5)
CFG_LABEL=$(basename "$SWEEP_CONFIG" .yaml)

LOG_DIR="$PBS_O_WORKDIR/logs/sweep_260323"
mkdir -p "$LOG_DIR"
ARRAY_ID="${PBS_ARRAY_INDEX:-1}"
JOB_LABEL="${CFG_LABEL}_${ARRAY_ID}"
exec >"$LOG_DIR/${JOB_LABEL}.out" 2>"$LOG_DIR/${JOB_LABEL}.err"

module purge
source .venv/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYSPI_N_JOBS=4

echo "[INFO] Config: ${SWEEP_CONFIG}"
echo "[INFO] Starting PBS array index ${ARRAY_ID} at $(date)"
python -m src.run_experiments \
  --job-index "${ARRAY_ID}" \
  --skip-existing \
  --experiment-config "${SWEEP_CONFIG}" \
  --threads 4 \
  --parquet
echo "[INFO] Finished at $(date)"
