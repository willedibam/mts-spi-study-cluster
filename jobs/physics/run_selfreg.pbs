#!/bin/bash
#PBS -N selfreg_spi
#PBS -l select=1:ncpus=4:mem=8gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -J 1-561
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Run pyspi on all 561 SelfRegulationSCP1 trials (279 positivity + 282 negativity).
# Pre-requisite: run src/prep_selfreg.py once before submitting this job.
#
# Submit from project root:
#   qsub jobs/physics/run_selfreg.pbs

set -euo pipefail

if [[ -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "[ERROR] PBS_O_WORKDIR not set."
  exit 1
fi

cd "$PBS_O_WORKDIR"

LOG_DIR="$PBS_O_WORKDIR/logs"
mkdir -p "$LOG_DIR"
ARRAY_ID="${PBS_ARRAY_INDEX:-1}"
JOB_LABEL="${PBS_JOBNAME}_${ARRAY_ID}"
exec >"$LOG_DIR/${JOB_LABEL}.out" 2>"$LOG_DIR/${JOB_LABEL}.err"

module purge
source .venv/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export KMP_DUPLICATE_LIB_OK=TRUE
export PYSPI_N_JOBS=4

echo "[INFO] Starting PBS array index ${ARRAY_ID} at $(date)"
python -m src.run_experiments \
  --job-index "${ARRAY_ID}" \
  --skip-existing \
  --experiment-config configs/generate/selfreg.yaml \
  --threads 4 \
  --parquet
echo "[INFO] Finished at $(date)"
