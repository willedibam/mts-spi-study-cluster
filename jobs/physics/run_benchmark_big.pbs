#!/bin/bash
#PBS -N bench_big
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -J 1-2
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Two-corner "big" benchmark to inform the next round of slow-tail SPI
# subsetting. Uses preset `scaling_big` (added to scripts/benchmark_spis.py):
#   array index 1: (M=32, T=2000)  -- wide-M corner; stresses pair-count /
#                                     BLAS-bound SPIs (covariance, distance
#                                     correlation, kernel, GP)
#   array index 2: (M=16, T=4000)  -- long-T corner; stresses sequence-bound
#                                     SPIs (DTW, spectral, kraskov TE)
#
# pyspi config is benchmarked_config.yaml (292 SPIs) -- the prior 36-SPI
# slow tail (HHG, GPModel, M-explosive CCM-mean variants, full-band spectral
# defaults, etc.) is already excluded. This run finds the NEXT tier of slow
# SPIs at larger (M, T) so we can refine the drop list.
#
# Resources: 8 ncpus + 32 GB per task. M=32 has 496 pairs and benefits from
# wide BLAS threading; M=16 long-T benefits less but the 8-thread baseline is
# still optimal vs spinning up more concurrent tasks. 2 tasks * 8 ncpus = 16
# of the 48-ncpu user cap -> both run concurrently in one wave.
#
# Walltime 24h is generous: at sweep_22 (M=16 T=800) ~110 min on the full
# 328-SPI superset, the corners projected pre-filter were ~9h (M=16 T=4000)
# and ~19h (M=32 T=2000). With the 36 heaviest SPIs already excluded, both
# should land well inside 24h, but the cap leaves headroom for tail variance.
# Physics queue has no resources_max.walltime, so 24h is accepted.

set -euo pipefail

if [[ -z "${PBS_O_WORKDIR:-}" ]]; then
  echo "[ERROR] PBS_O_WORKDIR not set."
  exit 1
fi

cd "$PBS_O_WORKDIR"

LOG_DIR="$PBS_O_WORKDIR/logs"
mkdir -p "$LOG_DIR"
ARRAY_ID="${PBS_ARRAY_INDEX:-1}"
JOB_LABEL="${PBS_JOBNAME}_${ARRAY_ID}"
exec >"$LOG_DIR/${JOB_LABEL}.out" 2>"$LOG_DIR/${JOB_LABEL}.err"

module purge
source .venv/bin/activate

# physics queue exports CUDA_VISIBLE_DEVICES="" on CPU-only jobs; cdt's
# autoset_settings() calls ast.literal_eval() on it at import and dies with
# SyntaxError. Unset so cdt falls back to the KeyError/CPU path.
unset CUDA_VISIBLE_DEVICES

NCPUS=8
export OMP_NUM_THREADS=$NCPUS
export OPENBLAS_NUM_THREADS=$NCPUS
export MKL_NUM_THREADS=$NCPUS
export NUMEXPR_NUM_THREADS=$NCPUS
export VECLIB_MAXIMUM_THREADS=$NCPUS
export KMP_DUPLICATE_LIB_OK=TRUE

PYSPI_CONFIG=/suphys/wedi0306/pyspi-fork/pyspi/benchmarked_config.yaml
OUTPUT_DIR="$PBS_O_WORKDIR/data/benchmark/big"
mkdir -p "$OUTPUT_DIR"

echo "[INFO] PBS array ${ARRAY_ID}/2 on $(hostname) at $(date)"
python scripts/benchmark_spis.py \
  --preset scaling_big \
  --array-index "${ARRAY_ID}" \
  --repeats 1 \
  --pyspi-config "$PYSPI_CONFIG" \
  --output "$OUTPUT_DIR/big_${ARRAY_ID}.json"
echo "[INFO] Finished at $(date)"
