#!/bin/bash
#PBS -N hcp-cohort-bank
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=16GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${CODE_SNAPSHOT:?}" "${RUNNER_SNAPSHOT:?}" "${AUDIT_ROOT:?}"
module load python3/3.12.1
source /scratch/ql44/we2614/venvs/mts-spi-v3-631de27/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export PYTHONPATH="$RUNNER_SNAPSHOT"
cd "$RUNNER_SNAPSHOT"
args=(--root "$AUDIT_ROOT")
if [[ "${CHECK_ONLY:-0}" == 1 ]]; then args+=(--check-only); fi
python -u "$CODE_SNAPSHOT/scripts/build_hcp_cohort_bank.py" "${args[@]}"
