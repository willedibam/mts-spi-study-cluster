#!/bin/bash
#PBS -N nt-induction-extract
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=48GB,walltime=01:30:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
: "${XFREQ_DATA:?}"
python -m scripts.neurotycho_induction extract --data "$XFREQ_DATA" --output "$XFREQ_DATA/analysis"
python -m scripts.audit_dependence_features --data "$XFREQ_DATA" --output "$XFREQ_DATA/analysis" --corpus neurotycho-induction-261006
