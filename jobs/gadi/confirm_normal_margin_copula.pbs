#!/bin/bash
#PBS -N copula-confirm
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=16GB,walltime=00:30:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
: "${COPULA_OLD:?}" "${COPULA_NEW:?}"
python -m scripts.analyze_tail_alignment extract --data "$COPULA_NEW" --output "$COPULA_NEW/analysis"
python -m scripts.audit_dependence_features --data "$COPULA_NEW" --output "$COPULA_NEW/analysis" --corpus t-copula-normal-margins-261006-replication
python -m scripts.confirm_normal_margin_copula --old-data "$COPULA_OLD" --old-output "$COPULA_OLD/analysis" --new-data "$COPULA_NEW" --new-output "$COPULA_NEW/analysis" --output "$COPULA_NEW/confirmation"
