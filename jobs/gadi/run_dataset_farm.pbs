#!/bin/bash
#PBS -N spi-farm
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=2
#PBS -l mem=8GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe

set -euo pipefail

: "${EXPERIMENT_CONFIG:?set EXPERIMENT_CONFIG}"
: "${END_INDEX:?set END_INDEX}"
START_INDEX="${START_INDEX:-1}"
PYSPI_CONFIG="${PYSPI_CONFIG:-configs/pyspi/benchmarked_p90.yaml}"

cd "${PBS_O_WORKDIR:?}"
test -f "$EXPERIMENT_CONFIG"
test -f "$PYSPI_CONFIG"

module purge
module load python3/3.12.1 nci-parallel/1.0.0a
source .venv/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export PYSPI_N_JOBS=1

# Optional pyspi source snapshot (a development branch) ahead of the shared
# editable install; meta.json records which pyspi ran.
if [[ -n "${PYSPI_SOURCE:-}" ]]; then
    test -d "$PYSPI_SOURCE/pyspi"
    export PYTHONPATH="$PYSPI_SOURCE${PYTHONPATH:+:$PYTHONPATH}"
fi
# (the old `unset CUDA_VISIBLE_DEVICES` guarded cdt's import-time
# ast.literal_eval of it; pyspi 3.0 dropped cdt, so it is gone)

python -c 'import src, pyspi'

commands="$PBS_JOBFS/dataset-commands.txt"
indices="$PBS_JOBFS/dataset-indices.txt"
mkdir -p logs

job_stem="${PBS_JOBNAME}_${PBS_JOBID%%.*}"
status="$PBS_O_WORKDIR/logs/${job_stem}.status"
exec >"$PBS_O_WORKDIR/logs/${job_stem}.log" 2>&1

selector=("$EXPERIMENT_CONFIG" --start "$START_INDEX" --end "$END_INDEX")
[[ -n "${FILTER_M:-}" ]] && selector+=(--M "$FILTER_M")
[[ -n "${FILTER_T:-}" ]] && selector+=(--T "$FILTER_T")
[[ -n "${INSTANCE_MIN:-}" ]] && selector+=(--instance-min "$INSTANCE_MIN")
[[ -n "${INSTANCE_MAX:-}" ]] && selector+=(--instance-max "$INSTANCE_MAX")
python -m scripts.select_dataset_indices "${selector[@]}" > "$indices"

# pyspi workers per dataset. Each dataset is bound to this many cores and runs
# that many workers; results do not depend on the count. Memory is per
# dataset, not per core: request WORKERS x (parent + CORES_PER_RECORDING x
# largest worker), from job.peak_memory_mib of a measured dataset.
cores_per_recording="${CORES_PER_RECORDING:-1}"
[[ "$cores_per_recording" =~ ^[1-9][0-9]*$ ]] || { echo "invalid CORES_PER_RECORDING" >&2; exit 2; }
while IFS= read -r i; do
    printf 'python -m src.run_experiments --job-index %d --experiment-config %s --pyspi-config %s --n-jobs %d --skip-existing --no-csv --no-heatmap\n' \
        "$i" "$EXPERIMENT_CONFIG" "$PYSPI_CONFIG" "$cores_per_recording" >> "$commands"
done < "$indices"

task_count=$(wc -l < "$indices")
workers="${WORKERS:-$(( PBS_NCPUS / cores_per_recording ))}"
(( workers >= 1 && workers * cores_per_recording <= PBS_NCPUS ))
(( workers > task_count )) && workers=$task_count

echo "[INFO] datasets=$START_INDEX..$END_INDEX workers=$workers cores_per_recording=$cores_per_recording p90=$PYSPI_CONFIG"
# Verify the shared editable installs on every allocated node before dispatch.
# A head-node-only import check misses node-local source/path mistakes.
nodes=$(sort -u "${PBS_NODEFILE:?}" | wc -l)
if (( nodes > 1 )); then
    mpirun -np "$nodes" --map-by ppr:1:node \
        python -c 'import socket, src, pyspi; print("[IMPORT OK]", socket.gethostname(), src.__file__, pyspi.__file__)'
fi
nci_args=(--verbose --input-file "$commands" --status "$status")
if [[ -n "${TASK_TIMEOUT:-}" ]]; then
    nci_args+=(--timeout "$TASK_TIMEOUT")
fi
set +e
mpirun -np "$workers" --map-by "node:PE=$cores_per_recording" \
    nci-parallel "${nci_args[@]}"
rc=$?
set -e
if (( rc == 0 )); then
    python - "$EXPERIMENT_CONFIG" "$indices" <<'PY'
import sys

from src.mapping import DatasetMapping, ExperimentConfig
from src.run_experiments import _dataset_complete

config, index_path = sys.argv[1], sys.argv[2]
mapping = DatasetMapping(ExperimentConfig.from_file(config))
with open(index_path, encoding="utf-8") as handle:
    indices = [int(line) for line in handle if line.strip()]
missing = [
    index
    for index in indices
    if not _dataset_complete(mapping.spec_for_index(index))
]
if missing:
    preview = ",".join(map(str, missing[:20]))
    raise SystemExit(f"incomplete dataset outputs ({len(missing)}): {preview}")
PY
    rc=$?
fi
exit "$rc"
