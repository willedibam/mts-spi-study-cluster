#!/bin/bash
#PBS -N spin-physics
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=48GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=2GB
#PBS -l storage=scratch/ql44
#PBS -l wd
#PBS -j oe

set -euo pipefail
: "${SCOUT_CONFIG:?set SCOUT_CONFIG}"
: "${END_INDEX:?set END_INDEX}"
START_INDEX="${START_INDEX:-1}"
SCOUT_SCRIPT="${SCOUT_SCRIPT:-scripts/spin_order_parameter_scout.py}"

cd "${PBS_O_WORKDIR:?}"
export MTS_SPI_REPO_ROOT="$PBS_O_WORKDIR"
export PYTHONPATH="$PBS_O_WORKDIR${PYTHONPATH:+:$PYTHONPATH}"
module purge
module load python3/3.12.1 nci-parallel/1.0.0a
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1

commands="$PBS_JOBFS/spin-physics-commands.txt"
for ((i=START_INDEX; i<=END_INDEX; i++)); do
    printf 'python %q --config %q --task-index %d\n' \
        "$SCOUT_SCRIPT" "$SCOUT_CONFIG" "$i" >> "$commands"
done
tasks=$((END_INDEX - START_INDEX + 1))
workers=$PBS_NCPUS
(( workers > tasks )) && workers=$tasks
mpirun -np "$workers" --map-by node:PE=1 \
    nci-parallel --verbose --input-file "$commands"
