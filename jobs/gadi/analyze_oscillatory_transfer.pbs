#!/bin/bash
#PBS -N oscillator-transfer-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=00:30:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OPENBLAS_NUM_THREADS=4 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
base=/g/data/ql44/we2614/oscillatory_coorganization_transfer_260909
python -m src.run_external_corpus --config configs/external/oscillatory-coorganization-transfer-260909.yaml --audit
python -m scripts.build_representation_state_bank --config configs/analysis/oscillatory-coorganization-transfer-260909.yaml \
 --data "$base" --mpi-root "$base/mpis/oscillatory-coorganization-transfer-260909" --output "$base/analysis/features.npz"
python -m scripts.build_spi_edge_bank --data "$base" --mpi-root "$base/mpis/oscillatory-coorganization-transfer-260909" \
 --bank "$base/analysis/features.npz" --output "$base/analysis/normalized-edges.npz"
