#!/bin/bash
#PBS -N tail-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=16GB,walltime=00:30:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
: "${TAIL_DATA:?}" "${TAIL_OUTPUT:?}"
python -m scripts.analyze_tail_alignment extract --data "$TAIL_DATA" --output "$TAIL_OUTPUT"
python -m scripts.audit_dependence_features --data "$TAIL_DATA" --output "$TAIL_OUTPUT" --corpus tail-alignment-261005
python -m scripts.analyze_tail_alignment analyze --data "$TAIL_DATA" --output "$TAIL_OUTPUT"
