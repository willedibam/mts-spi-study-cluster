#!/bin/bash
#PBS -N oscillator-mechanism
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OPENBLAS_NUM_THREADS=4 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
base=/g/data/ql44/we2614/oscillatory_coorganization_pilot_260909
config=configs/analysis/oscillatory-coorganization-mechanism-260909.yaml
exec >"$base/analysis/mechanism-${PBS_JOBID%%.*}.log" 2>&1
python -m scripts.build_interaction_share_nulls --config "$config" --data "$base" \
 --mpi-root "$base/mpis/oscillatory-coorganization-pilot-260909" --bank "$base/analysis/features.npz" \
 --output "$base/analysis/alignment"
for seed in 503 509 521; do
 python -m scripts.run_covariance_modulation --config "$config" --data "$base" \
  --feature-bank "$base/analysis/alignment/null-${seed}.npz" --methods z-pls \
  --output "$base/analysis/alignment/fits-${seed}"
done
