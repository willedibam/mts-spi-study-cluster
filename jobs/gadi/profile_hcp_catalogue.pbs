#!/bin/bash
#PBS -N hcp-p90-profile
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=64GB
#PBS -l walltime=06:00:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${CODE_SNAPSHOT:?}" "${RUN_ROOT:?}"
module load python3/3.12.1
source /scratch/ql44/we2614/venvs/mts-spi-v3-631de27/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
cd "$CODE_SNAPSHOT"
python -u -m scripts.profile_hcp_catalogue --config "$RUN_ROOT/m32-short/external.yaml" --index 1 --output "$RUN_ROOT/profile-T4000"
