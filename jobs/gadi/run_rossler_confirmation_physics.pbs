#!/bin/bash
#PBS -N rossler-confirm-physics
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=384
#PBS -l mem=1344GB
#PBS -l walltime=00:30:00
#PBS -l jobfs=4GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -j oe
set -euo pipefail
: "${SOURCE_DIR:?}" "${EXPECTED_COMMIT:?}" "${RESULT_ROOT:?}" "${SEAL:?}" "${FROZEN:?}"
cd "$SOURCE_DIR"
test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
module purge
module load python3/3.12.1 nci-parallel/1.0.0a
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export NUMBA_CACHE_DIR="$PBS_JOBFS/numba-cache"
export PYTHONPATH="$SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p "$RESULT_ROOT" logs
exec >"logs/rossler-confirm-physics-${PBS_JOBID}.log" 2>&1
python -m pytest -q tests/test_rossler_confirmation.py tests/test_finite_regime_pipeline.py
mpirun -np "${PBS_NNODES:-1}" --map-by ppr:1:node python -c 'import scripts.rossler_confirmation; print("shared source OK",flush=True)'
total=$(python -c 'from scripts.rossler_confirmation import cases; print(len(cases()))')
commands="$PBS_JOBFS/commands.txt"
for ((i=0;i<total;i++)); do
    if [[ "${SMOKE:-0}" == 1 ]] && (( i != 0 && i != total-1 )); then continue; fi
    printf 'python -m scripts.rossler_confirmation physics --index %d --root %s/physics --seal %s\n' "$i" "$RESULT_ROOT" "$SEAL" >> "$commands"
done
mpirun -np "$PBS_NCPUS" --map-by node:PE=1 nci-parallel --input-file "$commands" --status "$RESULT_ROOT/physics-${PBS_JOBID}.status"
if [[ "${SMOKE:-0}" != 1 ]]; then
    python -m scripts.rossler_confirmation gate-export --physics "$RESULT_ROOT/physics" --frozen "$FROZEN" --output "$RESULT_ROOT/primary" --seal "$SEAL"
fi
