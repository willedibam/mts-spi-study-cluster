#!/bin/bash
#PBS -N spi-feature-v2
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=192GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe

set -euo pipefail

: "${DATA_PATH:?set DATA_PATH}"
: "${OUTPUT:?set OUTPUT}"

cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

mkdir -p logs "$(dirname "$OUTPUT")"
job_stem="${PBS_JOBNAME}_${PBS_JOBID%%.*}"
exec >"$PBS_O_WORKDIR/logs/${job_stem}.log" 2>&1

args=(
    --data-path "$DATA_PATH"
    --output "$OUTPUT"
    --metric "${METRIC:-pearson}"
    --feature-contract direction_preserving_v2
    --workers "${WORKERS:-$PBS_NCPUS}"
)
if [[ -n "${SPI_SUBSET:-}" ]]; then
    args+=(--spi-subset "$SPI_SUBSET")
fi
if [[ -n "${DATASET_LIMIT:-}" ]]; then
    args+=(--dataset-limit "$DATASET_LIMIT")
fi
if [[ "${RECOMPUTE:-0}" == 1 ]]; then
    args+=(--recompute)
fi

python -m src.process_features "${args[@]}"
