#!/bin/bash
#PBS -N covmod-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=02:00:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OPENBLAS_NUM_THREADS=4 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
config=configs/analysis/covariance-modulation-260909.yaml
base=/g/data/ql44/we2614/covariance_modulation_260909
mkdir -p "$base/analysis"
exec >"$base/analysis/analysis-${PBS_JOBID%%.*}.log" 2>&1
git rev-parse HEAD
python -m src.run_external_corpus --config configs/external/covariance-modulation-260909.yaml --audit
if [[ ! -f "$base/analysis/features.npz" ]]; then
 python -m scripts.build_representation_state_bank --config "$config" --data "$base" \
  --mpi-root "$base/mpis/covariance-modulation-260909" --output "$base/analysis/features.npz"
fi
python -m scripts.run_covariance_modulation --config "$config" --data "$base" \
 --output "$base/analysis/statistical" --feature-bank "$base/analysis/features.npz" \
 --methods m-pls shape-pls z-pca z-pls shape+z-pls g-pls validity-pls
