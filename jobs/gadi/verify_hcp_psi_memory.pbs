#!/bin/bash
#PBS -N hcp-psi-memory
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=8GB
#PBS -l walltime=00:20:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${CODE_SNAPSHOT:?}" "${RUN_ROOT:?}"
module load python3/3.12.1
source /scratch/ql44/we2614/venvs/mts-spi-v3-631de27/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
cd "$CODE_SNAPSHOT"
python -u -m scripts.verify_hcp_psi_memory --config "$RUN_ROOT/m32-short/external.yaml" --index 33 --profile "$RUN_ROOT/profile-T2000" --output "$RUN_ROOT/psi-memory-verification.json"
python -u -m scripts.package_hcp_profile --config "$RUN_ROOT/m32-short/external.yaml" --index 33 --profile "$RUN_ROOT/profile-T2000"
