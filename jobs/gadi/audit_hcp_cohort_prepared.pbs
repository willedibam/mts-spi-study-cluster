export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python -u "$CODE_SNAPSHOT/scripts/audit_hcp_cohort_prepared.py" --audit-root "$AUDIT_ROOT" --cohort-root "$COHORT_ROOT"
