#!/bin/bash
#PBS -N cml2d-structure
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=96
#PBS -l mem=380GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=4GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -j oe
set -euo pipefail
: "${SOURCE_DIR:?}" "${EXPECTED_COMMIT:?}" "${STRUCTURE_ROOT:?}" "${PHYSICS_DIR:?}" "${STAGE:?}"
cd "$SOURCE_DIR"
test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
module purge
module load python3/3.12.1 nci-parallel/1.0.0a
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export NUMBA_CACHE_DIR="$PBS_JOBFS/numba-cache"
export PYTHONPATH="$SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"
mkdir -p "$STRUCTURE_ROOT/$STAGE"
if [[ "$STAGE" == aggregate ]]; then
    python -m scripts.cml2d_structure_diagnostic aggregate --root "$STRUCTURE_ROOT" --physics "$PHYSICS_DIR"
    exit
fi
mpirun -np "${PBS_NNODES:-1}" --map-by ppr:1:node python -c 'import scripts.cml2d_structure_diagnostic; print("shared source OK",flush=True)'
python -m pytest -q tests/test_cml2d_structure.py
if [[ "$STAGE" == audit ]]; then total=1360; elif [[ "$STAGE" == scout ]]; then total=620; else exit 2; fi
commands="$PBS_JOBFS/commands.txt"
for ((i=0;i<total;i++)); do
    if [[ "${SMOKE:-0}" == 1 ]] && (( i != 40 && i != 400 )); then continue; fi
    printf 'python -m scripts.cml2d_structure_diagnostic %s --root %s --physics %s --index %d\n' "$STAGE" "$STRUCTURE_ROOT" "$PHYSICS_DIR" "$i" >> "$commands"
done
mpirun -np "$PBS_NCPUS" --map-by node:PE=1 nci-parallel --input-file "$commands" --status "$STRUCTURE_ROOT/$STAGE-${PBS_JOBID}.status"
