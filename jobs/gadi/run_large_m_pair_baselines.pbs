#!/bin/bash
#PBS -N large-m-pair-baseline
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l walltime=02:00:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -j oe
set -euo pipefail
: "${SOURCE_DIR:?}" "${EXPECTED_COMMIT:?}" "${RESULT_ROOT:?}" "${STAGE:?}"
cd "$SOURCE_DIR"
test "$(git rev-parse HEAD)" = "$EXPECTED_COMMIT"
test "$(git -C /home/562/we2614/pyspi-fork rev-parse HEAD)" = 65317c9c1fd5f12358b8ede09b7576ef001a76dd
module purge
module load python3/3.12.1 nci-parallel/1.0.0a
source /scratch/ql44/we2614/venvs/mts-spi-v3-631de27/bin/activate
export PYTHONPATH="$SOURCE_DIR${PYTHONPATH:+:$PYTHONPATH}"
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export PYSPI_N_JOBS=1 PYTHONDONTWRITEBYTECODE=1
export NUMBA_CACHE_DIR="$PBS_JOBFS/numba-cache"
mkdir -p "$RESULT_ROOT/logs"
exec >"$RESULT_ROOT/logs/${STAGE}-${GROUP:-all}-${PBS_JOBID}.log" 2>&1
mpirun -np "${PBS_NNODES:-1}" --map-by ppr:1:node python -c 'import src, pyspi, scripts.large_m_pair_baselines; print(src.__file__, pyspi.__file__, flush=True)'
commands="$PBS_JOBFS/commands.txt"
if [[ "$STAGE" == prepare ]]; then
    python -m pytest -q -p no:cacheprovider tests/test_large_m_pair_baselines.py tests/test_hcp_spectral_memory.py tests/test_tasep_phase_boundary.py tests/test_cml2d_period_doubling.py
    for ((i=0;i<25;i++)); do
        printf 'python -m scripts.large_m_pair_baselines prepare --root %s --hcp-root /g/data/ql44/we2614/hcp_working_memory_audit_260912 --index %d\n' "$RESULT_ROOT" "$i" >> "$commands"
    done
    mpirun -np 25 --map-by node:PE=1 nci-parallel --input-file "$commands" --status "$RESULT_ROOT/preparation.status"
    python -m scripts.large_m_pair_baselines assemble --root "$RESULT_ROOT"
    for group in m64 m100 large; do
        python -m src.run_external_corpus --config "$RESULT_ROOT/$group.yaml" --validate-source
        python -m src.run_external_corpus --config "$RESULT_ROOT/$group.yaml" --job-index 1 --dry-run
    done
elif [[ "$STAGE" == smoke || "$STAGE" == rest ]]; then
    : "${GROUP:?}"
    if [[ "$STAGE" == rest ]]; then
        python -m scripts.large_m_pair_baselines gate --root "$RESULT_ROOT" --group "$GROUP"
    fi
    while IFS= read -r index; do
        printf 'python -m scripts.large_m_pair_baselines extract --root %s --group %s --index %d\n' "$RESULT_ROOT" "$GROUP" "$index" >> "$commands"
    done < "$RESULT_ROOT/$GROUP-$STAGE.txt"
    workers=$(wc -l < "$commands")
    mpirun -np "$workers" --map-by node:PE=1 nci-parallel --input-file "$commands" --status "$RESULT_ROOT/$GROUP-$STAGE.status"
    if [[ "$STAGE" == smoke ]]; then
        python -m scripts.large_m_pair_baselines gate --root "$RESULT_ROOT" --group "$GROUP"
    else
        python -m src.run_external_corpus --config "$RESULT_ROOT/$GROUP.yaml" --audit
    fi
else
    echo "Unknown stage: $STAGE" >&2
    exit 2
fi
