#!/bin/bash
#PBS -N state-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe

# Submit with afterok dependencies on every extraction farm. The bank builder
# independently verifies every observation and MPI before any model is fitted.
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4 VECLIB_MAXIMUM_THREADS=4

config=configs/analysis/representation-stage-b-260907.yaml
base=/g/data/ql44/we2614/representation_stage_b_260907
output="$base/analysis"
mkdir -p "$output"
exec >"$output/analysis-${PBS_JOBID%%.*}.log" 2>&1
git rev-parse HEAD
python -c 'import numpy, sklearn; print("NumPy", numpy.__version__, "scikit-learn", sklearn.__version__)'
python -m src.run_external_corpus \
    --config configs/external/representation-stage-b-260907.yaml --audit
python -m scripts.build_representation_state_bank \
    --config "$config" --data "$base" \
    --mpi-root "$base/mpis/representation-stage-b-260907" \
    --output "$output/features.npz"
python -m scripts.run_representation_state_pilot \
    --config "$config" --data "$base" --feature-bank "$output/features.npz" \
    --output "$output/statistical" --methods m z m+z m+g m+g+z validity
python -m scripts.report_representation_state_pilot \
    --config "$config" --data "$base" \
    --results "$output/statistical" "$base/comparison-fits/simple" \
      "$base/comparison-fits/neural" "$base/comparison-fits/random-control" \
      "$base/comparison-fits/raw-control" \
    --output "$output/report"
