#!/bin/bash
#PBS -N xfreq-snr-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4,mem=24GB,walltime=00:40:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
: "${XFREQ_DATA:?}"
python -m scripts.cross_frequency_locking_snr extract --data "$XFREQ_DATA" --output "$XFREQ_DATA/analysis"
python -m scripts.audit_dependence_features --data "$XFREQ_DATA" --output "$XFREQ_DATA/analysis" --corpus cross-frequency-locking-snr-261006
python -m scripts.cross_frequency_locking_snr analyze --data "$XFREQ_DATA" --output "$XFREQ_DATA/analysis"
