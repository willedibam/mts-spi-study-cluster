#!/bin/bash
#PBS -N proof-figures
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1 NUMEXPR_NUM_THREADS=1
exec >"logs/${PBS_JOBNAME}_${PBS_JOBID%%.*}.log" 2>&1
python -m scripts.finish_refresh_proof \
    --bank /scratch/ql44/we2614/mts-spi-study/proof/refresh-260924/features.npz \
    --output /scratch/ql44/we2614/mts-spi-study/proof/refresh-260924/analysis \
    --workers 16
