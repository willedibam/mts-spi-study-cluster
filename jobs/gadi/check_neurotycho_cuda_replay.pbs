#!/bin/bash
#PBS -N ecog-replay-audit
#PBS -P ql44
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=00:30:00
#PBS -l jobfs=5GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
base=/g/data/ql44/we2614/neurotycho_neural_260910
python -u scripts/check_neurotycho_cuda_replay.py --data "$base" \
    --fits "$base/fits" --output "$base/cuda-replay-audit.json"
