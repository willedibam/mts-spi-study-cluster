#!/bin/bash
#PBS -N ecog-neural
#PBS -P ql44
#PBS -q gpuhopper
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=96GB
#PBS -l walltime=02:30:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
: "${TARGET_ANIMAL:?}" "${FIT_SEED:?}"
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
base=/g/data/ql44/we2614/neurotycho_neural_260910
mkdir -p "$base/fits"
nvidia-smi
python -c 'import torch; print(torch.__version__, torch.cuda.get_device_name(0)); assert torch.cuda.is_available()'
python -u scripts/fit_neurotycho_neural.py \
    --data "$base" --output "$base/fits" --kind enriched --device cuda \
    --animal "$TARGET_ANIMAL" --seed "$FIT_SEED"
