#!/bin/bash
#PBS -N chimera-physics
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=48,mem=96GB,walltime=00:40:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
: "${CHIMERA_OUTPUT:?}"
args=(--output "$CHIMERA_OUTPUT" --workers "$PBS_NCPUS")
if [[ "${SCOUT_SMOKE:-0}" == 1 ]]; then args+=(--smoke); fi
if [[ "${SCOUT_REFINE:-0}" == 1 ]]; then args+=(--refine); fi
python -m scripts.scout_breathing_chimera "${args[@]}"
