#!/bin/bash
#PBS -N spi-farm
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=2
#PBS -l mem=8GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=10GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe

set -euo pipefail

: "${CORPUS_CONFIG:?set CORPUS_CONFIG}"

cd "${PBS_O_WORKDIR:?}"
test -f "$CORPUS_CONFIG"

source jobs/gadi/env.sh

# Source snapshots and the environment must be visible on every allocated node.
# Normal/express Cascade Lake nodes have 48 CPUs; smaller farms use one node.
import_ranks=$(( (PBS_NCPUS + 47) / 48 ))
mpirun -np "$import_ranks" --map-by ppr:1:node \
    python -c 'import mtsspi, pyspi, pathlib
here = pathlib.Path.cwd().resolve()
assert pathlib.Path(mtsspi.__file__).resolve().is_relative_to(here), f"mtsspi imported from {mtsspi.__file__}, not {here}"
print(mtsspi.__file__, pyspi.__file__)'
python -m mtsspi.run_corpus --config "$CORPUS_CONFIG" --validate-source

total=$(python -m mtsspi.run_corpus --config "$CORPUS_CONFIG" --count-only)
indices="$PBS_JOBFS/dataset-indices.txt"
if [[ -n "${INDEX_FILE:-}" ]]; then
    test -f "$INDEX_FILE"
    cp "$INDEX_FILE" "$indices"
else
    start="${START_INDEX:-1}"
    end="${END_INDEX:-$total}"
    (( start >= 1 && end >= start && end <= total ))
    seq "$start" "$end" > "$indices"
fi
if (( $(sort "$indices" | uniq -d | wc -l) != 0 )); then
    echo "index file contains duplicates: ${INDEX_FILE:-generated range}" >&2
    exit 2
fi

# pyspi workers per recording. Each recording is bound to this many cores
# (PE below) and the runner refuses to start if it was not. Needs a pyspi that
# pins its own estimator seeds (computation r8 on); memory is not checked here:
# request at least WORKERS x (parent + CORES_PER_RECORDING x largest worker)
# from a measured recording's job.peak_memory_mib.
cores_per_recording="${CORES_PER_RECORDING:-1}"
[[ "$cores_per_recording" =~ ^[1-9][0-9]*$ ]] || { echo "invalid CORES_PER_RECORDING" >&2; exit 2; }

commands="$PBS_JOBFS/dataset-commands.txt"
while IFS= read -r index; do
    [[ "$index" =~ ^[0-9]+$ ]] || { echo "invalid index: $index" >&2; exit 2; }
    (( index >= 1 && index <= total )) || { echo "out-of-range index: $index" >&2; exit 2; }
    printf 'python -m mtsspi.run_corpus --config %s --job-index %d --n-jobs %d --skip-existing\n' \
        "$CORPUS_CONFIG" "$index" "$cores_per_recording" >> "$commands"
done < "$indices"

task_count=$(wc -l < "$indices")
(( task_count >= 1 ))
workers="${WORKERS:-$(( PBS_NCPUS / cores_per_recording ))}"
(( workers >= 1 && workers * cores_per_recording <= PBS_NCPUS ))
(( workers > task_count )) && workers=$task_count

mkdir -p logs
job_stem="${PBS_JOBNAME}_${PBS_JOBID%%.*}"
status="$PBS_O_WORKDIR/logs/${job_stem}.status"
exec >"$PBS_O_WORKDIR/logs/${job_stem}.log" 2>&1

echo "[INFO] corpus=$CORPUS_CONFIG tasks=$task_count workers=$workers cores_per_recording=$cores_per_recording"
nci_args=(--verbose --input-file "$commands" --status "$status")
if [[ -n "${TASK_TIMEOUT:-}" ]]; then
    nci_args+=(--timeout "$TASK_TIMEOUT")
fi

set +e
mpirun -np "$workers" --map-by "node:PE=$cores_per_recording" nci-parallel "${nci_args[@]}"
rc=$?
set -e
if (( rc == 0 )); then
    python -m mtsspi.run_corpus \
        --config "$CORPUS_CONFIG" --audit --index-file "$indices"
    rc=$?
fi
exit "$rc"
