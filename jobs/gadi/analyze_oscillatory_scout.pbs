#!/bin/bash
#PBS -N oscillator-scout-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=00:45:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OPENBLAS_NUM_THREADS=4 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
base=/g/data/ql44/we2614/oscillatory_coorganization_scout_260909
mkdir -p "$base/analysis"
exec >"$base/analysis/job-${PBS_JOBID%%.*}.log" 2>&1
python -m src.run_external_corpus --config configs/external/oscillatory-coorganization-scout-260909.yaml --audit
python -m scripts.analyze_oscillatory_scout --data "$base" --output "$base/analysis"
