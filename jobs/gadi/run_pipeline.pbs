#!/bin/bash
#PBS -N pipeline
#PBS -P ql44
#PBS -q normal
#PBS -l walltime=12:00:00
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l jobfs=20GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -r y
#PBS -j oe
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Generic whole-node pipeline runner. Works for any experiment-config yaml.
# Submit via jobs/gadi/submit_pipeline.sh (handles Gadi's max_array_size=10
# cap by chunking).
#
# Required env from -v:
#   EXPERIMENT_CONFIG   path to configs/generate/.../*.yaml
#   TOTAL_DATASETS      total dataset count for this config (M*T*classes*instances)
# Optional env (with defaults):
#   CHUNK_SIZE=200             datasets per subjob (sequential within an array slot)
#   BATCH_OFFSET=0             dataset offset across batch wrappers
#   CONCURRENT_DATASETS=48     datasets processed concurrently per subjob
#   CORES_PER_DATASET=1        pyspi worker processes per dataset
#
# CONCURRENT_DATASETS and CORES_PER_DATASET are INDEPENDENT knobs:
#   - Lower CONCURRENT_DATASETS only if per-dataset memory would OOM the node
#     (idle cores are accepted as the price of memory headroom).
#   - Raise CORES_PER_DATASET only if a single dataset would bust walltime.
#   Default (48 x 1) is the efficient allocation: one core per dataset, 48
#   datasets in flight. Their product need not equal ncpus; if it exceeds
#   ncpus the script prints a warning (cores will be oversubscribed).

set -euo pipefail

: "${EXPERIMENT_CONFIG:?EXPERIMENT_CONFIG must be set (e.g. configs/generate/embeddings/foo.yaml)}"
: "${TOTAL_DATASETS:?TOTAL_DATASETS must be set}"
CHUNK_SIZE="${CHUNK_SIZE:-200}"
BATCH_OFFSET="${BATCH_OFFSET:-0}"
CONCURRENT_DATASETS="${CONCURRENT_DATASETS:-48}"
CORES_PER_DATASET="${CORES_PER_DATASET:-1}"
# PARQUET=0 skips calc.parquet/calc.csv. Those are ~3.2 MB/instance versus the
# ~0.2 MB spi_mpis.npz that downstream training actually reads, i.e. ~90% of
# the storage. Default stays 1 so existing experiments are unaffected.
PARQUET="${PARQUET:-1}"
PARQUET_FLAG=""
[[ "$PARQUET" == "1" ]] && PARQUET_FLAG="--parquet"

NCPUS=48
if [[ $(( CONCURRENT_DATASETS * CORES_PER_DATASET )) -gt $NCPUS ]]; then
    echo "[WARN] CONCURRENT_DATASETS*CORES_PER_DATASET = $(( CONCURRENT_DATASETS * CORES_PER_DATASET )) > ncpus=$NCPUS — cores will be oversubscribed."
fi

ARRAY_ID="${PBS_ARRAY_INDEX:-1}"
START_IDX=$(( BATCH_OFFSET + (ARRAY_ID - 1) * CHUNK_SIZE + 1 ))
END_IDX=$(( BATCH_OFFSET + ARRAY_ID * CHUNK_SIZE ))
if [[ $END_IDX -gt $TOTAL_DATASETS ]]; then
    END_IDX=$TOTAL_DATASETS
fi

LOG_DIR="logs"
mkdir -p "$LOG_DIR"
JOB_LABEL="${PBS_JOBNAME}_${PBS_JOBID%%.*}_o${BATCH_OFFSET}_a${ARRAY_ID}"
exec >"$LOG_DIR/${JOB_LABEL}.out" 2>"$LOG_DIR/${JOB_LABEL}.err"

module purge
module load python3/3.12.1

export UV_CACHE_DIR=/scratch/ql44/we2614/uv-cache
source .venv/bin/activate

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export KMP_DUPLICATE_LIB_OK=TRUE

# cdt (transitive pyspi import) does ast.literal_eval(os.environ["CUDA_VISIBLE_DEVICES"]).
unset CUDA_VISIBLE_DEVICES

echo "[INFO] config=$EXPERIMENT_CONFIG  offset=$BATCH_OFFSET  array=$ARRAY_ID"
echo "[INFO] datasets=${START_IDX}..${END_IDX}  concurrent_datasets=$CONCURRENT_DATASETS  cores_per_dataset=$CORES_PER_DATASET"
echo "[INFO] host=$(hostname)  start=$(date)"

if [[ $START_IDX -gt $TOTAL_DATASETS ]]; then
    echo "[INFO] start index $START_IDX > total $TOTAL_DATASETS — nothing to do."
    exit 0
fi

seq "$START_IDX" "$END_IDX" | \
    xargs -n 1 -P "$CONCURRENT_DATASETS" -I {} \
        python -m src.run_experiments \
            --job-index {} \
            --skip-existing \
            --experiment-config "$EXPERIMENT_CONFIG" \
            --n-jobs "$CORES_PER_DATASET" \
            $PARQUET_FLAG

echo "[INFO] finished at $(date)"
