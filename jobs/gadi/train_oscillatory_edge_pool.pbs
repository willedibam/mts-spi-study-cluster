#!/bin/bash
#PBS -N oscillator-edge-learning
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=6
#PBS -l mem=24GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
base=/g/data/ql44/we2614/oscillatory_coorganization_pilot_260909
mkdir -p "$base/analysis/learned-pooling/oscillatory"
pids=()
for seed in 11 23 47; do
 python -m scripts.run_representation_state_pilot --config configs/analysis/oscillatory-pooling-transfer-260909.yaml \
  --data "$base" --edge-bank "$base/analysis/normalized-edges.npz" --methods neural \
  --source-family oscillatory --device cpu --seeds "$seed" \
  --output "$base/analysis/learned-pooling/oscillatory" >"$base/analysis/learned-pooling/seed-${seed}.log" 2>&1 &
 pids+=("$!")
done
rc=0
for pid in "${pids[@]}"; do wait "$pid" || rc=1; done
exit "$rc"
