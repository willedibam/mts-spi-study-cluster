set -euo pipefail
: "${CODE_SNAPSHOT:?}" "${RUN_ROOT:?}"
module load python3/3.12.1
source /scratch/ql44/we2614/venvs/mts-spi-v3-631de27/bin/activate
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
python -u "$CODE_SNAPSHOT/scripts/audit_hcp_continuous.py" --root "$RUN_ROOT"
