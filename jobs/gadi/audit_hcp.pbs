#!/bin/bash
#PBS -N hcp-audit
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=1
#PBS -l mem=4GB
#PBS -l walltime=00:15:00
#PBS -l storage=gdata/ql44+scratch/ql44
