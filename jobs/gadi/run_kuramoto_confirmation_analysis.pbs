#!/bin/bash
#PBS -N kuramoto-confirm-analysis
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=64GB
#PBS -l walltime=02:00:00
#PBS -l jobfs=4GB
#PBS -l storage=scratch/ql44
#PBS -l wd
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MKL_NUM_THREADS=4 NUMEXPR_NUM_THREADS=4
mkdir -p logs
exec >"logs/${PBS_JOBNAME}_${PBS_JOBID%%.*}.log" 2>&1
python scripts/analyze_kuramoto_confirmation.py
