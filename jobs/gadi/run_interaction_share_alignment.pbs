#!/bin/bash
#PBS -N interaction-null
#PBS -P ql44
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l jobfs=2GB
#PBS -l storage=gdata/ql44+scratch/ql44
#PBS -l wd
#PBS -j oe
set -euo pipefail
cd "${PBS_O_WORKDIR:?}"
module purge
module load python3/3.12.1
source .venv/bin/activate
export OPENBLAS_NUM_THREADS=4 OMP_NUM_THREADS=4 MKL_NUM_THREADS=4
export NUMEXPR_NUM_THREADS=4 VECLIB_MAXIMUM_THREADS=4
base=/g/data/ql44/we2614/interaction_share_260908
config=configs/analysis/interaction-share-260908.yaml
output="$base/alignment"
mkdir -p "$output"
exec >"$output/alignment-${PBS_JOBID%%.*}.log" 2>&1
git rev-parse HEAD
python -m scripts.build_interaction_share_nulls --config "$config" --data "$base" \
 --mpi-root "$base/mpis/interaction-share-260908" --bank "$base/analysis/features.npz" --output "$output/banks"
for seed in 503 509 521; do
 python -m scripts.run_interaction_share_pilot --config "$config" --data "$base" --output "$output/fits" \
  --feature-bank "$output/banks/null-$seed.npz" --methods z-pca z-pls --method-prefix "null${seed}_"
done
python -m scripts.report_interaction_share_pilot --config "$config" --data "$base" \
 --inputs "$output/fits" --output "$output/report"
