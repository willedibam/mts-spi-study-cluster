#!/bin/bash
#PBS -N cml_psweep
#PBS -P ql44
#PBS -q normal
#PBS -l walltime=06:00:00
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l jobfs=20GB
#PBS -l storage=scratch/ql44+gdata/ql44
#PBS -l wd
#PBS -r y
#PBS -j oe
#PBS -m bea
#PBS -M wedi0306@uni.sydney.edu.au

# Whole-node dataset-level parallelism.
#   PARALLEL datasets run concurrently via xargs -P, each with PYSPI_N_JOBS workers.
#   Default: PARALLEL=12, PYSPI_N_JOBS=4  ->  48 cores saturated.
#
# Gadi caps array_size=10. Wrapper submits multiple arrays; each subjob
# processes CHUNK_SIZE contiguous dataset indices sequentially (in xargs waves).
#   start = BATCH_OFFSET + (PBS_ARRAY_INDEX - 1) * CHUNK_SIZE + 1
#   end   = BATCH_OFFSET +  PBS_ARRAY_INDEX      * CHUNK_SIZE
# --skip-existing keeps resubmissions idempotent.

set -euo pipefail

CHUNK_SIZE="${CHUNK_SIZE:-122}"
BATCH_OFFSET="${BATCH_OFFSET:-0}"
TOTAL_DATASETS="${TOTAL_DATASETS:-2440}"
PARALLEL="${PARALLEL:-12}"
PYSPI_JOBS="${PYSPI_JOBS:-4}"

ARRAY_ID="${PBS_ARRAY_INDEX:-1}"
START_IDX=$(( BATCH_OFFSET + (ARRAY_ID - 1) * CHUNK_SIZE + 1 ))
END_IDX=$(( BATCH_OFFSET + ARRAY_ID * CHUNK_SIZE ))
if [[ $END_IDX -gt $TOTAL_DATASETS ]]; then
    END_IDX=$TOTAL_DATASETS
fi

LOG_DIR="logs"
mkdir -p "$LOG_DIR"
JOB_LABEL="${PBS_JOBNAME}_o${BATCH_OFFSET}_a${ARRAY_ID}"
exec >"$LOG_DIR/${JOB_LABEL}.out" 2>"$LOG_DIR/${JOB_LABEL}.err"

module purge
module load python3/3.12.1

export UV_CACHE_DIR=/scratch/ql44/we2614/uv-cache
source .venv/bin/activate

# BLAS threads pinned to 1 per worker process — each dataset run already
# spawns PYSPI_N_JOBS joblib workers; letting BLAS multi-thread inside those
# oversubscribes and thrashes.
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export KMP_DUPLICATE_LIB_OK=TRUE
export PYSPI_N_JOBS="$PYSPI_JOBS"

# cdt (imported transitively by pyspi.statistics.causal) does
# ast.literal_eval(os.environ["CUDA_VISIBLE_DEVICES"]) at import time.
# Empty-string crashes literal_eval; unset forces cdt's fallback.
unset CUDA_VISIBLE_DEVICES

echo "[INFO] offset=$BATCH_OFFSET array=$ARRAY_ID datasets=${START_IDX}..${END_IDX}  parallel=$PARALLEL  pyspi_jobs=$PYSPI_JOBS  host=$(hostname) start=$(date)"

if [[ $START_IDX -gt $TOTAL_DATASETS ]]; then
    echo "[INFO] start index $START_IDX > total $TOTAL_DATASETS — nothing to do."
    exit 0
fi

# xargs fans out per-dataset Python invocations. Stdout interleaves across
# the PARALLEL workers — grep by dataset slug (M*_T*_I*_a*|e*) if you need
# to isolate one run. Each run is self-contained (separate output dir).
seq "$START_IDX" "$END_IDX" | \
    xargs -n 1 -P "$PARALLEL" -I {} \
        python -m src.run_experiments \
            --job-index {} \
            --skip-existing \
            --experiment-config configs/generate/embeddings/cml-param-sweep.yaml \
            --threads "$PYSPI_JOBS" \
            --parquet

echo "[INFO] finished at $(date)"
