# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.build/
dist/

# venv (no trailing slash — also matches symlinks-to-directories, which
# `git clean -fd` otherwise treats as tracked-candidate files and removes)
.venv
.env
.venv-*

# notebooks
.ipynb_checkpoints/

# results/cache/data (no trailing slash on `data` — it's a symlink on Gadi)
cache/
data
results/
features/
tar/

# OS
.DS_Store
Thumbs.db

# Local notebooks and caches
playing.ipynb
jupyter/
notebooks/**/_*_cache.npz

# logs
log/
logs

# generated figures / rich-display intermediates
figures/
media/

# PowerShell scripts
*.ps1

# PBS outputs (jobs also write durable logs under the ignored logs symlink)
spi_array.*
*.o[0-9]*
*.e[0-9]*

# Local archives and scratch trees
data_backup.tar.gz
Random/
random/
*.tar.gz

# Editor / recovery
.vscode/
.git.broken/
